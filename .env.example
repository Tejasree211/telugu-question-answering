# API Keys for Speech Services (get from respective dashboards)

# Sarvam AI - Best for Telugu (https://dashboard.sarvam.ai/)
SARVAM_API_KEY=your-sarvam-api-key-here

# OpenAI - Good fallback (https://platform.openai.com/)
OPENAI_API_KEY=your-openai-api-key-here

# Speech Provider Toggle
# Options: sarvam, openai, google
# - sarvam: Best Telugu quality (requires SARVAM_API_KEY)
# - openai: Good quality (requires OPENAI_API_KEY)
# - google: Free fallback (no API key needed)
ASR_PROVIDER=sarvam
TTS_PROVIDER=sarvam
